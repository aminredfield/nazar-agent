+/**
+ * Расходы ИИ-помощника компании на модели — только для суперадмина.
+ *
+ * Помощник сообщает о каждом вызове модели: роль, модель, токены, цена в
+ * долларах. Здесь — итоги за сегодня, 7 и 30 дней и за всё время, разбивка
+ * за 30 дней и последние запуски. Суммы в сумах — по курсу из финансов.
+ */
+import { useCallback, useEffect, useState } from "react";
+
+import { getSuperAdminCompanyAiUsage } from "../../api/aiUsage";
+import { formatDateTime } from "../../lib/format";
+import type { AiUsageTotals, SuperAdminCompanyAiUsage } from "../../types/aiUsage";
+import { Panel } from "../ui/Panel";
+import { StatCard } from "../ui/StatCard";
+import { AI_ROLE_LABELS, AI_SOURCE_LABELS, formatAiCost, formatTokens } from "./aiUsageFormat";
+
+type CompanyAiUsagePanelProps = {
+  companyId: string;
+};
+
+export function CompanyAiUsagePanel({ companyId }: CompanyAiUsagePanelProps) {
+  const [data, setData] = useState<SuperAdminCompanyAiUsage | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  const load = useCallback(async () => {
+    setError(null);
+    try {
+      setData(await getSuperAdminCompanyAiUsage(companyId));
+    } catch (requestError) {
+      setError(requestError instanceof Error ? requestError.message : "Не удалось загрузить расходы ИИ.");
+    }
+  }, [companyId]);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  if (error) {
+    return (
+      <Panel title="ИИ-помощник: расходы">
+        <div className="alert-danger">{error}</div>
+      </Panel>
+    );
+  }
+  if (!data) return null;
+  // A company that never had the assistant has nothing to show here.
+  if (!data.ai_agent_enabled && data.all.runs === 0) return null;
+
+  const rate = data.usd_uzs_rate;
+  const tile = (label: string, totals: AiUsageTotals) => (
+    <StatCard
+      label={label}
+      value={formatAiCost(totals.cost_usd, rate, totals.estimated)}
+      hint={`Запусков: ${totals.runs} · токенов ${formatTokens(totals.input_tokens)} → ${formatTokens(totals.output_tokens)}`}
+    />
+  );
+
+  return (
+    <Panel
+      title="ИИ-помощник: расходы"
+      description={`Каждый вызов модели: роль, модель, токены, цена. В сумах — по курсу ${formatTokens(rate)} сум за доллар (меняется в финансах). * — часть цены — оценка: у модели нет опубликованного прайса.`}
+      actions={
+        <button type="button" className="btn-secondary btn-sm" onClick={() => void load()}>
+          Обновить
+        </button>
+      }
+    >
+      <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
+        {tile("Сегодня", data.today)}
+        {tile("7 дней", data.week)}
+        {tile("30 дней", data.month)}
+        {tile("Всего", data.all)}
+      </div>
+
+      {data.by_role.length ? (
+        <div className="mt-6 overflow-x-auto">
+          <div className="label-xs mb-2">По ролям и моделям, 30 дней</div>
+          <table className="w-full text-sm">
+            <thead className="text-left text-muted">
+              <tr>
+                <th className="py-2 pr-3 font-medium">Роль</th>
+                <th className="py-2 pr-3 font-medium">Модель</th>
+                <th className="py-2 pr-3 text-right font-medium">Вызовов</th>
+                <th className="py-2 pr-3 text-right font-medium">Токенов</th>
+                <th className="py-2 text-right font-medium">Цена</th>
+              </tr>
+            </thead>
+            <tbody>
+              {data.by_role.map((row) => (
+                <tr key={`${row.role}:${row.model}`} className="border-t border-border">
+                  <td className="py-2 pr-3">{AI_ROLE_LABELS[row.role] ?? row.role}</td>
+                  <td className="py-2 pr-3 font-mono text-xs text-muted">{row.model}</td>
+                  <td className="py-2 pr-3 text-right">{row.calls}</td>
+                  <td className="py-2 pr-3 text-right font-mono text-xs">
+                    {formatTokens(row.input_tokens)} → {formatTokens(row.output_tokens)}
+                  </td>
+                  <td className="py-2 text-right">{formatAiCost(row.cost_usd, rate, row.estimated)}</td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      ) : (
+        <p className="mt-4 text-sm text-muted">Помощник включён, но ещё ни разу не вызывал модели.</p>
+      )}
+
+      {data.recent.length ? (
+        <div className="mt-6 overflow-x-auto">
+          <div className="label-xs mb-2">Последние запуски</div>
+          <table className="w-full text-sm">
+            <tbody>
+              {data.recent.map((run) => (
+                <tr key={run.run_id} className="border-t border-border">
+                  <td className="py-2 pr-3 whitespace-nowrap">{formatDateTime(run.at)}</td>
+                  <td className="py-2 pr-3">{AI_SOURCE_LABELS[run.source] ?? run.source}</td>
+                  <td className="py-2 pr-3 text-right text-muted">{run.calls} вызовов</td>
+                  <td className="py-2 pr-3 text-right font-mono text-xs">
+                    {formatTokens(run.input_tokens)} → {formatTokens(run.output_tokens)}
+                  </td>
+                  <td className="py-2 text-right">{formatAiCost(run.cost_usd, rate, run.estimated)}</td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      ) : null}
+    </Panel>
+  );
+}
