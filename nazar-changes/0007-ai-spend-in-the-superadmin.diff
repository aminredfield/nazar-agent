+/**
+ * Расходы ИИ-помощника в карточке компании суперадмина.
+ *
+ * Деньги показываются в долларах и в сумах по курсу платформы; цена-оценка
+ * помечена звёздочкой; компания без помощника и без расходов карточки не
+ * получает вовсе.
+ */
+import { cleanup, render, screen } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+
+const getSuperAdminCompanyAiUsage = vi.fn();
+
+vi.mock("../../api/aiUsage", () => ({
+  getSuperAdminCompanyAiUsage: (...args: unknown[]) => getSuperAdminCompanyAiUsage(...args),
+}));
+
+const { CompanyAiUsagePanel } = await import("./CompanyAiUsagePanel");
+
+const ZERO = { runs: 0, input_tokens: 0, output_tokens: 0, cost_usd: 0, estimated: false };
+
+function usage(overrides = {}) {
+  return {
+    usd_uzs_rate: 12800,
+    ai_agent_enabled: true,
+    today: { runs: 2, input_tokens: 30000, output_tokens: 5600, cost_usd: 0.06, estimated: true },
+    week: { runs: 2, input_tokens: 30000, output_tokens: 5600, cost_usd: 0.06, estimated: true },
+    month: { runs: 2, input_tokens: 30000, output_tokens: 5600, cost_usd: 0.06, estimated: true },
+    all: { runs: 2, input_tokens: 30000, output_tokens: 5600, cost_usd: 0.06, estimated: true },
+    by_role: [
+      { role: "attendance_analyst", model: "muse-spark-1.3", calls: 2, runs: 2, input_tokens: 24000, output_tokens: 1600, cost_usd: 0.04, estimated: false },
+    ],
+    recent: [],
+    ...overrides,
+  };
+}
+
+afterEach(() => {
+  cleanup();
+  vi.clearAllMocks();
+});
+
+it("shows the spend in dollars and sums, an estimate marked", async () => {
+  getSuperAdminCompanyAiUsage.mockResolvedValue(usage());
+
+  render(<CompanyAiUsagePanel companyId="c-1" />);
+
+  expect(await screen.findByText("ИИ-помощник: расходы")).toBeTruthy();
+  expect(screen.getAllByText(/\$0\.0600\* · 768 сум/).length).toBe(4);
+  expect(screen.getByText("Аналитик отметок")).toBeTruthy();
+  expect(screen.getByText(/\$0\.0400 · 512 сум/)).toBeTruthy();
+  expect(getSuperAdminCompanyAiUsage).toHaveBeenCalledWith("c-1");
+});
+
+it("stays hidden for a company that never had the assistant", async () => {
+  getSuperAdminCompanyAiUsage.mockResolvedValue(
+    usage({ ai_agent_enabled: false, today: ZERO, week: ZERO, month: ZERO, all: ZERO, by_role: [] }),
+  );
+
+  const { container } = render(<CompanyAiUsagePanel companyId="c-2" />);
+
+  await vi.waitFor(() => expect(getSuperAdminCompanyAiUsage).toHaveBeenCalled());
+  await new Promise((resolve) => setTimeout(resolve, 0));
+  expect(container.textContent).toBe("");
+});
