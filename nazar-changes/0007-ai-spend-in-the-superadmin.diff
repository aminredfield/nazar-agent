+
+from app.db.base import Base
+
+
+class AiUsageCall(Base):
+    """One call of the AI assistant to a model, reported by the assistant service.
+
+    What the assistant spent on a company: which role (dispatcher, analyst,
+    skeptic…), which model, how many tokens and at what price. The price comes
+    from the assistant: it knows each provider's rates; ``estimated`` marks a
+    model without a published price, counted high rather than free. Calls of
+    one question share ``run_id``. Only the platform's superadmin sees this.
+    """
+
+    __tablename__ = "ai_usage_calls"
