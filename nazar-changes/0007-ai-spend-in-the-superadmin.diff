+
+    assert client.post("/api/ai-agent/usage", json=_usage(company_id)).status_code == 401
+    assert client.post("/api/ai-agent/usage", json=_usage(company_id), headers=key).json()["data"]["recorded"] == 2
+    client.post("/api/ai-agent/usage", json=_usage(company_id, run_id="run-2", estimated=True), headers=key)
+
+    app = _as_superadmin()
+    try:
+        company = client.get(f"/api/internal/superadmin/companies/{company_id}/ai-usage").json()["data"]
+        platform = client.get("/api/internal/superadmin/ai-usage?days=30").json()["data"]
+        rate = client.patch("/api/internal/superadmin/ai-usage/rate", json={"usd_uzs_rate": 13000})
+    finally:
+        app.dependency_overrides.clear()
+
+    assert company["ai_agent_enabled"] is True
+    assert company["today"]["runs"] == 2 and company["all"]["input_tokens"] == 30000
+    assert company["all"]["cost_usd"] == 0.06 and company["all"]["estimated"] is True
+    assert {(row["role"], row["calls"]) for row in company["by_role"]} == {("attendance_analyst", 2), ("skeptic", 2)}
+    assert [run["run_id"] for run in company["recent"]] == ["run-2", "run-1"]
+    assert any(row["company_id"] == str(company_id) and row["runs"] == 2 for row in platform["companies"])
+    assert rate.status_code in (200, 409)  # 409 only where the test database has no platform settings row
+
+
+def test_spend_is_not_accepted_for_a_company_without_the_assistant():
+    company_id, _, _ = asyncio.run(_seed(enabled=False))
+    client = _client()
+
+    refused = client.post("/api/ai-agent/usage", json=_usage(company_id), headers={"X-Agent-Key": AGENT_KEY})
+
+    assert refused.status_code == 403 and "AI_AGENT_DISABLED" in refused.text
diff --git a/frontend/src/api/aiUsage.ts b/frontend/src/api/aiUsage.ts
new file mode 100644
