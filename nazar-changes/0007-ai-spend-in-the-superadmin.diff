--- /dev/null
+++ b/frontend/src/api/aiUsage.ts
@@ -0,0 +1,25 @@
+import { INTERNAL_API_URL, apiFetch, buildHeaders, handleResponse } from "./http";
+import type { SuperAdminAiUsage, SuperAdminCompanyAiUsage } from "../types/aiUsage";
+
+export async function getSuperAdminCompanyAiUsage(companyId: string): Promise<SuperAdminCompanyAiUsage> {
+  const response = await apiFetch(`${INTERNAL_API_URL}/superadmin/companies/${companyId}/ai-usage`, {
+    headers: buildHeaders(),
+  });
+  return handleResponse<SuperAdminCompanyAiUsage>(response);
+}
+
+export async function getSuperAdminAiUsage(days = 30): Promise<SuperAdminAiUsage> {
+  const response = await apiFetch(`${INTERNAL_API_URL}/superadmin/ai-usage?days=${days}`, {
+    headers: buildHeaders(),
+  });
+  return handleResponse<SuperAdminAiUsage>(response);
+}
+
+export async function updateSuperAdminAiUsageRate(usdUzsRate: number): Promise<{ usd_uzs_rate: number }> {
+  const response = await apiFetch(`${INTERNAL_API_URL}/superadmin/ai-usage/rate`, {
+    method: "PATCH",
+    headers: buildHeaders(undefined, { json: true }),
+    body: JSON.stringify({ usd_uzs_rate: usdUzsRate }),
+  });
+  return handleResponse<{ usd_uzs_rate: number }>(response);
+}
diff --git a/frontend/src/components/superadmin/AiUsageOverview.tsx b/frontend/src/components/superadmin/AiUsageOverview.tsx
new file mode 100644
index 00000000..bb5a6de5
--- /dev/null
+++ b/frontend/src/components/superadmin/AiUsageOverview.tsx
@@ -0,0 +1,143 @@
+/**
+ * Расходы ИИ-помощника по всей платформе — в финансах суперадмина.
+ *
+ * Сколько ушло на модели за период и по каким компаниям, в долларах и в
+ * сумах. Здесь же курс доллара, по которому суммы пересчитываются в сумы.
+ */
+import { useCallback, useEffect, useState } from "react";
+import { Link } from "react-router-dom";
+
+import { getSuperAdminAiUsage, updateSuperAdminAiUsageRate } from "../../api/aiUsage";
+import type { SuperAdminAiUsage } from "../../types/aiUsage";
+import { Panel } from "../ui/Panel";
+import { StatCard } from "../ui/StatCard";
+import { formatAiCost, formatTokens } from "./aiUsageFormat";
+
+const PERIODS = [7, 30, 90] as const;
+
+export function AiUsageOverview() {
+  const [days, setDays] = useState<number>(30);
+  const [data, setData] = useState<SuperAdminAiUsage | null>(null);
+  const [rate, setRate] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [saved, setSaved] = useState<string | null>(null);
+
+  const load = useCallback(async () => {
+    setError(null);
+    try {
+      const result = await getSuperAdminAiUsage(days);
+      setData(result);
+      setRate(String(result.usd_uzs_rate));
+    } catch (requestError) {
+      setError(requestError instanceof Error ? requestError.message : "Не удалось загрузить расходы ИИ.");
+    }
+  }, [days]);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  const saveRate = async () => {
+    const value = Number(rate.replace(/\s/g, "").replace(",", "."));
+    if (!Number.isFinite(value) || value < 1000 || value > 100_000) {
+      setError("Курс — число от 1 000 до 100 000 сумов за доллар.");
+      return;
+    }
+    setError(null);
+    try {
+      await updateSuperAdminAiUsageRate(value);
+      setSaved("Курс сохранён.");
+      await load();
+    } catch (requestError) {
+      setError(requestError instanceof Error ? requestError.message : "Не удалось сохранить курс.");
+    }
+  };
+
+  return (
+    <Panel
+      title="ИИ-помощник: расходы на модели"
+      description="Токены и цена всех вызовов моделей помощником по компаниям. * — часть цены — оценка: у модели нет опубликованного прайса."
+      actions={
+        <div className="flex gap-1">
+          {PERIODS.map((period) => (
+            <button
+              key={period}
+              type="button"
+              className={period === days ? "btn-primary btn-sm" : "btn-secondary btn-sm"}
+              onClick={() => setDays(period)}
+            >
+              {period} дн.
+            </button>
+          ))}
+        </div>
+      }
+    >
+      {error ? <div className="alert-danger mb-4">{error}</div> : null}
+      {saved ? <div className="alert-success mb-4">{saved}</div> : null}
+      {data ? (
+        <>
+          <div className="grid gap-3 sm:grid-cols-3">
+            <StatCard label={`Всего за ${data.days} дн.`} value={formatAiCost(data.total.cost_usd, data.usd_uzs_rate, data.total.estimated)} />
+            <StatCard label="Запусков" value={data.total.runs} />
+            <StatCard
+              label="Токенов"
+              value={formatTokens(data.total.input_tokens + data.total.output_tokens)}
+              hint={`вход ${formatTokens(data.total.input_tokens)} · выход ${formatTokens(data.total.output_tokens)}`}
+            />
+          </div>
+
+          {data.companies.length ? (
+            <div className="mt-6 overflow-x-auto">
+              <table className="w-full text-sm">
+                <thead className="text-left text-muted">
+                  <tr>
+                    <th className="py-2 pr-3 font-medium">Компания</th>
+                    <th className="py-2 pr-3 text-right font-medium">Запусков</th>
+                    <th className="py-2 pr-3 text-right font-medium">Токенов</th>
+                    <th className="py-2 text-right font-medium">Цена</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {data.companies.map((row) => (
+                    <tr key={row.company_id} className="border-t border-border">
+                      <td className="py-2 pr-3">
+                        <Link className="text-primary hover:underline" to={`/superadmin/companies/${row.company_id}`}>
+                          {row.company_name}
+                        </Link>
+                      </td>
+                      <td className="py-2 pr-3 text-right">{row.runs}</td>
+                      <td className="py-2 pr-3 text-right font-mono text-xs">
+                        {formatTokens(row.input_tokens)} → {formatTokens(row.output_tokens)}
+                      </td>
+                      <td className="py-2 text-right">{formatAiCost(row.cost_usd, data.usd_uzs_rate, row.estimated)}</td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+          ) : (
+            <p className="mt-4 text-sm text-muted">За период помощник не вызывал моделей.</p>
+          )}
+
+          <div className="mt-6 flex flex-wrap items-end gap-3">
+            <label className="block">
+              <span className="field-label">Курс доллара, сум</span>
+              <input
+                className="field-input w-40"
+                inputMode="decimal"
+                value={rate}
+                onChange={(event) => {
+                  setRate(event.target.value);
+                  setSaved(null);
+                }}
+              />
+            </label>
+            <button type="button" className="btn-secondary btn-sm" onClick={() => void saveRate()}>
+              Сохранить курс
+            </button>
+          </div>
+        </>
+      ) : null}
+    </Panel>
+  );
+}
