+/** Money and tokens of the AI assistant's spend: dollars as billed, sums by the platform rate. */
+
+export const AI_ROLE_LABELS: Record<string, string> = {
+  dispatcher: "Диспетчер",
+  attendance_analyst: "Аналитик отметок",
+  timesheet_analyst: "Аналитик табеля",
+  photos: "Инспектор фото",
+  skeptic: "Скептик",
+  writer: "Составитель",
+  voice: "Голос",
+  import: "Разбор списков",
+  setup_analyst: "Аналитик настройки",
+};
+
+export const AI_SOURCE_LABELS: Record<string, string> = {
+  ask: "Окно помощника",
+  telegram: "Telegram",
+  voice: "Голос",
+  import: "Импорт",
+  brief: "Утренняя сводка",
+  setup: "Настройка",
+};
+
+const tokens = new Intl.NumberFormat("ru-RU");
+const sums = new Intl.NumberFormat("ru-RU", { maximumFractionDigits: 0 });
+
+export function formatTokens(value: number): string {
+  return tokens.format(value);
+}
+
+/** "$0.0312 · 399 сум"; an asterisk marks a price that is partly an estimate. */
+export function formatAiCost(usd: number, rate: number, estimated: boolean): string {
+  return `$${usd.toFixed(usd < 1 ? 4 : 2)}${estimated ? "*" : ""} · ${sums.format(usd * rate)} сум`;
+}
