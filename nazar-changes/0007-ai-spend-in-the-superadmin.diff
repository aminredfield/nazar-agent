@@ -0,0 +1,83 @@
+from __future__ import annotations
+
+import uuid
+from datetime import datetime
+from typing import Literal
+
+from pydantic import BaseModel, Field
+
+AiUsageSource = Literal["ask", "voice", "import", "telegram", "brief", "setup"]
+
+
+class AiUsageCallIn(BaseModel):
+    role: str = Field(min_length=1, max_length=40)
+    model: str = Field(min_length=1, max_length=120)
+    input_tokens: int = Field(ge=0, le=10_000_000)
+    output_tokens: int = Field(ge=0, le=10_000_000)
+    cost_usd: float = Field(ge=0, le=100)
+    estimated: bool = False
+
+
+class AiUsageReport(BaseModel):
+    """What one run of the assistant (a question, a voice message…) spent on models."""
+
+    company_id: uuid.UUID
+    run_id: str = Field(min_length=1, max_length=64)
+    source: AiUsageSource
+    calls: list[AiUsageCallIn] = Field(min_length=1, max_length=60)
+
+
+class AiUsageReportResponse(BaseModel):
+    recorded: int
+
+
+class AiUsageTotals(BaseModel):
+    runs: int
+    input_tokens: int
+    output_tokens: int
+    cost_usd: float
+    estimated: bool
+
+
+class AiUsageByRole(AiUsageTotals):
+    role: str
+    model: str
+    calls: int
+
+
+class AiUsageRun(BaseModel):
+    run_id: str
+    at: datetime
+    source: str
+    calls: int
+    input_tokens: int
+    output_tokens: int
+    cost_usd: float
+    estimated: bool
+
+
+class SuperAdminCompanyAiUsageResponse(BaseModel):
+    usd_uzs_rate: float
+    ai_agent_enabled: bool
+    today: AiUsageTotals
+    week: AiUsageTotals
+    month: AiUsageTotals
+    all: AiUsageTotals
+    by_role: list[AiUsageByRole]  # the last 30 days
+    recent: list[AiUsageRun]
+
+
+class AiUsageCompanyRow(AiUsageTotals):
+    company_id: uuid.UUID
+    company_name: str
+
+
+class SuperAdminAiUsageResponse(BaseModel):
+    usd_uzs_rate: float
+    days: int
+    total: AiUsageTotals
+    companies: list[AiUsageCompanyRow]
+
+
+class AiUsageRateUpdate(BaseModel):
+    usd_uzs_rate: float = Field(ge=1000, le=100_000)
diff --git a/backend/app/services/ai_usage_service.py b/backend/app/services/ai_usage_service.py
new file mode 100644
index 00000000..71b2539f
--- /dev/null
+++ b/backend/app/services/ai_usage_service.py
@@ -0,0 +1,154 @@
+"""What the AI assistant spends on models: recorded per call, summed for the superadmin.
+
+The assistant service reports every model call of a run (a question, a voice
+message, a list it read) with its tokens and price in dollars. Here the
+calls are stored and summed: per company — today, 7 and 30 days, in all, by
+role and model, the latest runs — and per platform. "Today" is the Tashkent
+day. Sums are also shown in sums by the platform's dollar rate.
+"""
+
+from __future__ import annotations
+
+import uuid
+from datetime import datetime, timedelta
+
+from sqlalchemy import func, select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.models import AiUsageCall, Company, PlatformSetting
+from app.schemas.ai_usage import (
+    AiUsageByRole,
+    AiUsageCompanyRow,
+    AiUsageReport,
+    AiUsageRun,
+    AiUsageTotals,
+)
+from app.services.work_schedule_service import TASHKENT_TIMEZONE
+
+DEFAULT_USD_UZS_RATE = 12800.0
+RECENT_RUNS = 15
+
+
+async def record(session: AsyncSession, report: AiUsageReport) -> int:
+    session.add_all(
+        AiUsageCall(
+            company_id=report.company_id,
+            run_id=report.run_id,
+            source=report.source,
+            role=call.role,
+            model=call.model,
+            input_tokens=call.input_tokens,
+            output_tokens=call.output_tokens,
+            cost_usd=call.cost_usd,
+            estimated=call.estimated,
+        )
+        for call in report.calls
+    )
+    await session.commit()
+    return len(report.calls)
+
+
+async def usd_uzs_rate(session: AsyncSession) -> float:
+    settings = await session.get(PlatformSetting, 1)
+    return float(settings.ai_usd_uzs_rate) if settings is not None else DEFAULT_USD_UZS_RATE
+
+
+async def set_usd_uzs_rate(session: AsyncSession, rate: float) -> float:
+    settings = await session.get(PlatformSetting, 1)
+    if settings is None:
+        raise LookupError("Platform settings are not initialised.")
+    settings.ai_usd_uzs_rate = rate
+    await session.commit()
+    return rate
+
+
+def _totals_columns():
+    return (
+        func.count(func.distinct(AiUsageCall.run_id)),
+        func.coalesce(func.sum(AiUsageCall.input_tokens), 0),
+        func.coalesce(func.sum(AiUsageCall.output_tokens), 0),
+        func.coalesce(func.sum(AiUsageCall.cost_usd), 0),
+        func.coalesce(func.bool_or(AiUsageCall.estimated), False),
+    )
+
+
+def _totals(row) -> AiUsageTotals:
+    runs, tokens_in, tokens_out, cost, estimated = row
+    return AiUsageTotals(
+        runs=runs, input_tokens=tokens_in, output_tokens=tokens_out, cost_usd=round(float(cost), 4), estimated=bool(estimated)
+    )
+
+
+def period_starts(now: datetime) -> dict[str, datetime | None]:
+    local = now.astimezone(TASHKENT_TIMEZONE)
+    midnight = local.replace(hour=0, minute=0, second=0, microsecond=0)
+    return {"today": midnight, "week": midnight - timedelta(days=6), "month": midnight - timedelta(days=29), "all": None}
+
+
+async def company_summary(session: AsyncSession, company_id: uuid.UUID, now: datetime) -> dict:
+    periods = {}
+    for name, since in period_starts(now).items():
+        query = select(*_totals_columns()).where(AiUsageCall.company_id == company_id)
+        if since is not None:
+            query = query.where(AiUsageCall.created_at >= since)
+        periods[name] = _totals((await session.execute(query)).one())
+
+    month_start = period_starts(now)["month"]
+    by_role = (
+        await session.execute(
+            select(AiUsageCall.role, AiUsageCall.model, func.count(), *_totals_columns())
+            .where(AiUsageCall.company_id == company_id, AiUsageCall.created_at >= month_start)
+            .group_by(AiUsageCall.role, AiUsageCall.model)
+            .order_by(func.sum(AiUsageCall.cost_usd).desc())
+        )
+    ).all()
+    recent = (
+        await session.execute(
+            select(
+                AiUsageCall.run_id,
+                func.min(AiUsageCall.created_at),
+                func.min(AiUsageCall.source),
+                func.count(),
+                func.sum(AiUsageCall.input_tokens),
+                func.sum(AiUsageCall.output_tokens),
+                func.sum(AiUsageCall.cost_usd),
+                func.bool_or(AiUsageCall.estimated),
+            )
+            .where(AiUsageCall.company_id == company_id)
+            .group_by(AiUsageCall.run_id)
+            .order_by(func.min(AiUsageCall.created_at).desc())
+            .limit(RECENT_RUNS)
+        )
+    ).all()
+    return {
+        **periods,
+        "by_role": [
+            AiUsageByRole(role=role, model=model, calls=calls, **_totals(rest).model_dump())
+            for role, model, calls, *rest in by_role
+        ],
+        "recent": [
+            AiUsageRun(
+                run_id=run_id, at=at, source=source, calls=calls, input_tokens=tokens_in, output_tokens=tokens_out,
+                cost_usd=round(float(cost), 4), estimated=bool(estimated),
+            )
+            for run_id, at, source, calls, tokens_in, tokens_out, cost, estimated in recent
+        ],
+    }
+
+
+async def platform_summary(session: AsyncSession, days: int, now: datetime) -> tuple[AiUsageTotals, list[AiUsageCompanyRow]]:
+    since = period_starts(now)["today"] - timedelta(days=days - 1)
+    total = _totals((await session.execute(select(*_totals_columns()).where(AiUsageCall.created_at >= since))).one())
+    rows = (
+        await session.execute(
+            select(Company.id, Company.name, *_totals_columns())
+            .join(AiUsageCall, AiUsageCall.company_id == Company.id)
+            .where(AiUsageCall.created_at >= since)
+            .group_by(Company.id, Company.name)
+            .order_by(func.sum(AiUsageCall.cost_usd).desc())
+        )
+    ).all()
+    return total, [
+        AiUsageCompanyRow(company_id=company_id, company_name=name, **_totals(rest).model_dump())
+        for company_id, name, *rest in rows
+    ]
