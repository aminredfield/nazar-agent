diff --git a/backend/tests/test_attendance_device_key.py b/backend/tests/test_attendance_device_key.py
new file mode 100644
index 00000000..b22482a4
--- /dev/null
+++ b/backend/tests/test_attendance_device_key.py
@@ -0,0 +1,24 @@
+"""The device key on an attendance event: enough to see one phone used by several people."""
+
+from types import SimpleNamespace
+
+from app.services.attendance_service import DEVICE_KEY_LENGTH, device_key_of
+
+
+def test_two_people_on_one_phone_share_the_key():
+    phone = "a1b2c3d4e5f6a7b8c9d0" * 3
+    first = SimpleNamespace(device_binding=SimpleNamespace(browser_hash=phone))
+    second = SimpleNamespace(device_binding=SimpleNamespace(browser_hash=phone))
+
+    assert device_key_of(first) == device_key_of(second) == phone[:DEVICE_KEY_LENGTH]
+
+
+def test_only_the_start_of_the_hash_leaves_nazar():
+    key = device_key_of(SimpleNamespace(device_binding=SimpleNamespace(browser_hash="f" * 64)))
+
+    assert len(key) == DEVICE_KEY_LENGTH
+
+
+def test_no_binding_no_key():
+    assert device_key_of(SimpleNamespace(device_binding=None)) is None
+    assert device_key_of(SimpleNamespace()) is None
