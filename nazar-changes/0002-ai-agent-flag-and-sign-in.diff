new file mode 100644
index 00000000..c0dde254
--- /dev/null
+++ b/backend/tests/test_ai_agent.py
@@ -0,0 +1,70 @@
+"""The pass into the AI assistant: short-lived, never a session by itself."""
+
+import uuid
+from datetime import UTC, datetime
+
+import pytest
+from pydantic import ValidationError
+
+from app.core.config import Settings
+from app.core.security import (
+    AGENT_HANDOFF_SECONDS,
+    InvalidTokenError,
+    _encode_jwt,
+    create_access_token,
+    create_agent_handoff_token,
+    decode_access_token,
+    decode_agent_handoff_token,
+)
+from tests.test_config import _production
+
+SETTINGS = Settings(_env_file=None, jwt_secret_key="test-secret-for-assistant-passes-0123456789")
+ACCOUNT = uuid.uuid4()
+COMPANY = uuid.uuid4()
+
+
+def test_pass_carries_the_person_and_the_company_and_lives_a_minute():
+    token, expires_at = create_agent_handoff_token(account_id=ACCOUNT, company_id=COMPANY, settings=SETTINGS)
+
+    payload = decode_agent_handoff_token(token, SETTINGS)
+
+    assert (payload.user_id, payload.company_id) == (ACCOUNT, COMPANY)
+    assert 0 < (expires_at - datetime.now(UTC)).total_seconds() <= AGENT_HANDOFF_SECONDS
+
+
+def test_pass_is_not_a_session():
+    """The session check accepts only token_use == "access"; a pass says otherwise."""
+    token, _ = create_agent_handoff_token(account_id=ACCOUNT, company_id=COMPANY, settings=SETTINGS)
+
+    assert decode_access_token(token, SETTINGS).token_use == "agent_handoff"
+
+
+def test_a_session_is_not_a_pass():
+    access, _ = create_access_token(user_id=ACCOUNT, settings=SETTINGS, company_id=COMPANY)
+
+    with pytest.raises(InvalidTokenError, match="not an assistant pass"):
+        decode_agent_handoff_token(access, SETTINGS)
+
+
+def test_expired_or_foreign_pass_is_refused():
+    expired = _encode_jwt(
+        {"user_id": str(ACCOUNT), "company_id": str(COMPANY), "subject_type": "company_user",
+         "token_use": "agent_handoff", "exp": int(datetime.now(UTC).timestamp()) - 1},
+        SETTINGS.jwt_secret_key,
+    )
+    foreign, _ = create_agent_handoff_token(
+        account_id=ACCOUNT, company_id=COMPANY, settings=Settings(_env_file=None, jwt_secret_key="x" * 40)
+    )
+
+    with pytest.raises(InvalidTokenError, match="expired"):
+        decode_agent_handoff_token(expired, SETTINGS)
+    with pytest.raises(InvalidTokenError, match="signature"):
+        decode_agent_handoff_token(foreign, SETTINGS)
+
+
+def test_production_needs_a_strong_assistant_key():
+    with pytest.raises(ValidationError, match="AI_AGENT_KEY"):
+        Settings(**_production(ai_agent_url="https://agent.example.com", ai_agent_key="short"))
+
+    Settings(**_production(ai_agent_url="https://agent.example.com", ai_agent_key="k" * 40))
+    Settings(**_production())  # no assistant configured: nothing to check
diff --git a/backend/tests/test_ai_agent_http_postgres.py b/backend/tests/test_ai_agent_http_postgres.py
new file mode 100644
index 00000000..01c276a9
--- /dev/null
+++ b/backend/tests/test_ai_agent_http_postgres.py
@@ -0,0 +1,111 @@
+"""Opening the AI assistant from the cabinet, over real HTTP.
+
+The pass from the cabinet → the assistant service exchanges it, with its key,
+for the admin's own session → that session works like the cabinet's. The pass
+alone is never a session, and switching the assistant off stops both steps.
+
+SKIPPED unless ``DATABASE_URL`` = ``TEST_DATABASE_URL`` (postgres).
+"""
+
+import asyncio
+import os
+import uuid
+
+import pytest
+from sqlalchemy import text
+from sqlalchemy.ext.asyncio import async_sessionmaker, create_async_engine
+
+from app.core.security import create_access_token
+from app.db.base import Base
+from app.models import AdminAccount, Company, CompanyUser
+from app.models.company_setting import CompanySetting
+from app.services.permissions import ROLE_OWNER
+
+TEST_DATABASE_URL = os.getenv("TEST_DATABASE_URL")
+DATABASE_URL = os.getenv("DATABASE_URL")
+AGENT_URL = "https://agent.example.com"
+AGENT_KEY = "k" * 40
+
+pytestmark = pytest.mark.skipif(
+    not TEST_DATABASE_URL or DATABASE_URL != TEST_DATABASE_URL,
+    reason="Set DATABASE_URL=TEST_DATABASE_URL (postgres) to run the assistant HTTP tests.",
+)
+
+
+def _client():
+    from sqlalchemy.ext.asyncio import AsyncSession
+    from sqlalchemy.pool import NullPool
+    from starlette.testclient import TestClient
+
+    import app.api.routes.ai_agent as ai_agent_routes
+    import app.db.session as db_session
+    from app.core.config import Settings
+    from app.main import app
+    from app.main import settings as app_settings
+
+    ai_agent_routes.settings = Settings(database_url=TEST_DATABASE_URL, ai_agent_url=AGENT_URL, ai_agent_key=AGENT_KEY)
+    db_session.SessionLocal = async_sessionmaker(
+        create_async_engine(TEST_DATABASE_URL, poolclass=NullPool, future=True),
+        expire_on_commit=False,
+        class_=AsyncSession,
+    )
+    return TestClient(app, base_url=f"http://{app_settings.trusted_hosts[0]}")
+
+
+async def _seed(enabled: bool) -> tuple[uuid.UUID, uuid.UUID, str]:
+    engine = create_async_engine(TEST_DATABASE_URL, future=True)
+    async with engine.begin() as conn:
+        await conn.execute(text("CREATE EXTENSION IF NOT EXISTS vector"))
+        await conn.run_sync(Base.metadata.create_all)
+    session_factory = async_sessionmaker(engine, expire_on_commit=False)
+    async with session_factory() as session:
+        company = Company(name=f"Agent Co {uuid.uuid4().hex[:6]}", is_demo=True, subscription_plan="demo")
+        session.add(company)
+        await session.flush()
+        account = AdminAccount(full_name="Owner", email=f"owner-{uuid.uuid4().hex[:8]}@example.com", password_hash="x", is_active=True)
+        session.add(account)
+        await session.flush()
+        session.add(CompanyUser(company_id=company.id, account_id=account.id, is_active=True, role=ROLE_OWNER))
+        session.add(CompanySetting(company_id=company.id, ai_agent_enabled=enabled))
+        await session.commit()
+        company_id, account_id = company.id, account.id
+    await engine.dispose()
+    from app.core.config import get_settings
+
+    session_token, _ = create_access_token(user_id=account_id, settings=get_settings(), company_id=company_id)
+    return company_id, account_id, session_token
+
+
+def test_cabinet_pass_becomes_the_admins_own_session():
+    company_id, _, session_token = asyncio.run(_seed(enabled=True))
+    client = _client()
+    cabinet = {"Authorization": f"Bearer {session_token}"}
+
+    handoff = client.post("/api/ai-agent/handoff", headers=cabinet)
+    assert handoff.status_code == 200, handoff.text
+    url = handoff.json()["data"]["url"]
+    assert url.startswith(f"{AGENT_URL}/#handoff=")
+    pass_token = url.split("#handoff=", 1)[1]
+
+    # The pass by itself opens nothing.
+    assert client.get("/api/objects", headers={"Authorization": f"Bearer {pass_token}"}).status_code == 401
+    # Only the assistant service, with its key, can exchange it.
+    assert client.post("/api/ai-agent/session", json={"handoff": pass_token}).status_code == 401
+    assert client.post("/api/ai-agent/session", json={"handoff": pass_token}, headers={"X-Agent-Key": "wrong" * 8}).status_code == 401
+
+    exchanged = client.post("/api/ai-agent/session", json={"handoff": pass_token}, headers={"X-Agent-Key": AGENT_KEY})
+    assert exchanged.status_code == 200, exchanged.text
+    data = exchanged.json()["data"]
+    assert data["company_id"] == str(company_id) and data["role"] == ROLE_OWNER
+    agent = {"Authorization": f"Bearer {data['access_token']}"}
+    assert client.get("/api/objects", headers=agent).status_code == 200
+    assert client.get("/api/auth/me", headers=agent).json()["data"]["features"]["ai_agent"] is True
+
+
+def test_switched_off_assistant_gives_no_pass():
+    _, _, session_token = asyncio.run(_seed(enabled=False))
+    client = _client()
+
+    refused = client.post("/api/ai-agent/handoff", headers={"Authorization": f"Bearer {session_token}"})
+
+    assert refused.status_code == 403 and "AI_AGENT_DISABLED" in refused.text
