@@ -0,0 +1,16 @@
+// ИИ-помощник (NAZAR Agent) — отдельный сервис; кабинет только открывает его.
+import { PUBLIC_API_URL, apiFetch, buildHeaders, handleResponse } from "./http";
+
+export interface AssistantHandoff {
+  /** Адрес окна помощника с одноразовым пропуском во фрагменте (#handoff=…). */
+  url: string;
+  expires_at: string;
+}
+
+export async function createAssistantHandoff(): Promise<AssistantHandoff> {
+  const response = await apiFetch(`${PUBLIC_API_URL}/ai-agent/handoff`, {
+    method: "POST",
+    headers: buildHeaders(),
+  });
+  return handleResponse<AssistantHandoff>(response);
+}
diff --git a/frontend/src/pages/AssistantPage.tsx b/frontend/src/pages/AssistantPage.tsx
new file mode 100644
index 00000000..93119469
--- /dev/null
+++ b/frontend/src/pages/AssistantPage.tsx
@@ -0,0 +1,69 @@
+/**
+ * «Помощник» — вход в ИИ-помощника (NAZAR Agent), отдельный сервис.
+ *
+ * Страница только открывает его: просит у сервера одноразовый пропуск и
+ * открывает окно помощника. Помощник работает правами того, кто его открыл, и
+ * ничего не меняет без подтверждения — это и сказано на странице, чтобы
+ * человек знал, что отдаёт, прежде чем нажать.
+ *
+ * Пункт меню и страница есть только у компаний, которым суперадмин включил
+ * помощника (`features.ai_agent`); остальных страница уводит на дашборд.
+ */
+import { useState } from "react";
+import { Navigate } from "react-router-dom";
+
+import { createAssistantHandoff } from "../api/client";
+import { useAuth } from "../hooks/useAuth";
+import { useI18n } from "../i18n/I18nProvider";
+
+export function AssistantPage() {
+  const { t } = useI18n();
+  const { session } = useAuth();
+  const [opening, setOpening] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  if (session?.features.ai_agent !== true) return <Navigate to="/app" replace />;
+
+  const open = async () => {
+    setOpening(true);
+    setError(null);
+    // The tab is opened inside the click, before the request: a window
+    // opened after an await is what popup blockers stop.
+    const tab = window.open("", "_blank");
+    try {
+      const { url } = await createAssistantHandoff();
+      if (tab) {
+        tab.opener = null;
+        tab.location.href = url;
+      } else {
+        window.location.assign(url);
+      }
+    } catch (failure) {
+      tab?.close();
+      setError(failure instanceof Error ? failure.message : t("Не получилось открыть помощника."));
+    } finally {
+      setOpening(false);
+    }
+  };
+
+  return (
+    <div className="max-w-2xl space-y-5">
+      <div>
+        <h1 className="text-xl font-bold text-ink">{t("Помощник")}</h1>
+        <p className="text-sm text-muted">
+          {t("Команда ИИ-агентов разбирает отметки и табель и приносит рекомендации с доказательствами.")}
+        </p>
+      </div>
+      <ul className="list-disc space-y-1 pl-5 text-sm text-ink">
+        <li>{t("Спросите словами: «Что в табеле за прошлую неделю стоит проверить перед выплатой?»")}</li>
+        <li>{t("Каждый вывод — со ссылками на отметки и дни табеля; отдельный агент ищет невиновное объяснение.")}</li>
+        <li>{t("Ничего не меняется без вашего подтверждения; любое действие можно отменить.")}</li>
+        <li>{t("Помощник работает с вашими правами: чего нельзя вам в кабинете, того нельзя и ему.")}</li>
+      </ul>
+      <button type="button" className="btn-primary" disabled={opening} onClick={open}>
+        {opening ? t("Открываю…") : t("Открыть помощника")}
+      </button>
+      {error ? <p className="text-sm text-danger-text">{error}</p> : null}
+    </div>
+  );
+}
