         raise InvalidTokenError("Token payload is invalid.") from exc
 
 
+AGENT_HANDOFF_TOKEN_USE = "agent_handoff"
+# Пропуск из кабинета в окно помощника живёт минуту: столько нужно, чтобы
+# открылась вкладка и агент обменял его на сессию.
+AGENT_HANDOFF_SECONDS = 60
+
+
+def create_agent_handoff_token(
+    *, account_id: uuid.UUID, company_id: uuid.UUID, settings: Settings
+) -> tuple[str, datetime]:
+    """Пропуск в помощника. Не вход: проверка сессии пускает только ``access``."""
+    issued_at = datetime.now(UTC)
+    expires_at = issued_at + timedelta(seconds=AGENT_HANDOFF_SECONDS)
+    payload = {
+        "user_id": str(account_id),
+        "company_id": str(company_id),
+        "subject_type": "company_user",
+        "token_use": AGENT_HANDOFF_TOKEN_USE,
+        "jti": str(uuid.uuid4()),
+        "iat": int(issued_at.timestamp()),
+        "exp": int(expires_at.timestamp()),
+    }
+    return _encode_jwt(payload, settings.jwt_secret_key), expires_at
+
+
+def decode_agent_handoff_token(token: str, settings: Settings) -> TokenPayload:
+    payload = decode_access_token(token, settings)
+    if payload.token_use != AGENT_HANDOFF_TOKEN_USE or payload.company_id is None:
+        raise InvalidTokenError("Token is not an assistant pass.")
+    return payload
+
+
 def create_device_token(
     *,
     binding_id: uuid.UUID,
