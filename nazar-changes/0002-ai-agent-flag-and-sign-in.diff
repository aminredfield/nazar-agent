diff --git a/backend/app/api/routes/ai_agent.py b/backend/app/api/routes/ai_agent.py
new file mode 100644
index 00000000..67c5c5d1
--- /dev/null
+++ b/backend/app/api/routes/ai_agent.py
@@ -0,0 +1,156 @@
+"""Вход в ИИ-помощника (NAZAR Agent) из кабинета.
+
+Помощник — отдельный сервис (github.com/aminredfield/nazar-agent). Он работает
+с данными компании **правами того, кто его открыл**, а не общим служебным
+аккаунтом: что человек не может в кабинете, того не сможет и помощник, и в
+аудите действия помощника записаны на этого человека.
+
+1. ``POST /ai-agent/handoff`` — кабинет просит пропуск. Пропуск живёт минуту
+   и сам по себе не вход: проверка сессии пускает только токены ``access``.
+   Кабинет открывает окно помощника, передавая пропуск во фрагменте адреса
+   (``#handoff=…``) — фрагмент не уходит на сервер и не оседает в логах.
+2. ``POST /ai-agent/session`` — сервер помощника меняет пропуск на обычный
+   токен доступа этого человека. Только с общим ключом ``AI_AGENT_KEY``:
+   перехваченный пропуск без ключа бесполезен.
+
+Помощник включается суперадмином для каждой компании отдельно
+(``company_settings.ai_agent_enabled``); выключили — новые пропуска и обмены
+не выдаются.
+"""
+
+from __future__ import annotations
+
+import hmac
+import uuid
+from datetime import datetime
+
+from fastapi import APIRouter, Depends, Header, HTTPException, Request, status
+from pydantic import BaseModel, Field
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.api.dependencies import get_audit_service, get_auth_context, get_db_session
+from app.api.responses import success_response
+from app.core.auth_context import AuthContext
+from app.core.config import get_settings
+from app.core.security import (
+    InvalidTokenError,
+    create_access_token,
+    create_agent_handoff_token,
+    decode_agent_handoff_token,
+)
+from app.repositories.audit_repository import AuditLogRepository
+from app.repositories.company_repository import CompanyRepository
+from app.repositories.company_settings_repository import CompanySettingsRepository
+from app.repositories.company_user_repository import CompanyUserRepository
+from app.schemas.common import ApiResponse
+from app.services.audit_service import AuditService
+
+router = APIRouter(prefix="/ai-agent", tags=["ai-agent"])
+settings = get_settings()
+
+
+class AgentHandoffResponse(BaseModel):
+    url: str
+    expires_at: datetime
+
+
+class AgentSessionRequest(BaseModel):
+    handoff: str = Field(min_length=20, max_length=4096)
+
+
+class AgentSessionResponse(BaseModel):
+    access_token: str
+    expires_at: datetime
+    company_id: uuid.UUID
+    company_name: str
+    full_name: str
+    email: str
+    role: str
+
+
+async def _enabled(session: AsyncSession, company_id: uuid.UUID) -> bool:
+    company_settings = await CompanySettingsRepository(session).get(company_id)
+    return bool(company_settings and company_settings.ai_agent_enabled)
+
+
+@router.post(
+    "/handoff",
+    response_model=ApiResponse[AgentHandoffResponse],
+    summary="A one-minute pass that opens the AI assistant for this admin",
+)
+async def create_handoff(
+    auth_context: AuthContext = Depends(get_auth_context),
+    session: AsyncSession = Depends(get_db_session),
+    audit: AuditService = Depends(get_audit_service),
+):
+    if not settings.ai_agent_url:
+        raise HTTPException(status.HTTP_503_SERVICE_UNAVAILABLE, "AI_AGENT_NOT_CONFIGURED: Помощник не подключён.")
+    if auth_context.company_id is None or auth_context.account_id is None:
+        raise HTTPException(status.HTTP_403_FORBIDDEN, "FORBIDDEN: Company context is required.")
+    if not await _enabled(session, auth_context.company_id):
+        raise HTTPException(status.HTTP_403_FORBIDDEN, "AI_AGENT_DISABLED: Помощник не включён для компании.")
+
+    token, expires_at = create_agent_handoff_token(
+        account_id=auth_context.account_id, company_id=auth_context.company_id, settings=settings
+    )
+    await audit.record("ai_agent.handoff", entity_type="ai_agent")
+    return success_response(
+        data=AgentHandoffResponse(url=f"{settings.ai_agent_url.rstrip('/')}/#handoff={token}", expires_at=expires_at)
+    )
+
+
+@router.post(
+    "/session",
+    response_model=ApiResponse[AgentSessionResponse],
+    summary="The assistant service exchanges a pass for the admin's own session",
+    include_in_schema=False,
+)
+async def create_session(
+    payload: AgentSessionRequest,
+    request: Request,
+    agent_key: str = Header(default="", alias="X-Agent-Key"),
+    session: AsyncSession = Depends(get_db_session),
+):
+    # Без настроенного ключа обмена нет вовсе; сравнение — за постоянное время.
+    if not settings.ai_agent_key or not hmac.compare_digest(agent_key.encode(), settings.ai_agent_key.encode()):
+        raise HTTPException(status.HTTP_401_UNAUTHORIZED, "Assistant key is invalid.")
+    try:
+        handoff = decode_agent_handoff_token(payload.handoff, settings)
+    except InvalidTokenError as exc:
+        raise HTTPException(status.HTTP_401_UNAUTHORIZED, str(exc)) from exc
+
+    company_id = handoff.company_id
+    users = CompanyUserRepository(session)
+    account = await users.get_account(handoff.user_id)
+    membership = await users.get_membership_for_account(company_id=company_id, account_id=handoff.user_id)
+    company = await CompanyRepository(session).get(company_id)
+    if account is None or not account.is_active or membership is None or not membership.is_active or company is None:
+        raise HTTPException(status.HTTP_401_UNAUTHORIZED, "User is inactive.")
+    # Выключили помощника, пока пропуск был в пути, — сессии не будет.
+    if not await _enabled(session, company_id):
+        raise HTTPException(status.HTTP_403_FORBIDDEN, "AI_AGENT_DISABLED: Помощник не включён для компании.")
+
+    access_token, expires_at = create_access_token(user_id=account.id, settings=settings, company_id=company_id)
+    try:
+        await AuditLogRepository(session).create(
+            company_id=company_id,
+            actor_user_id=membership.id,
+            actor_type="company_user",
+            actor_email=membership.email,
+            action="ai_agent.session",
+            request_ip=request.client.host if request.client else None,
+        )
+        await session.commit()
+    except Exception:  # pragma: no cover - audit must never break the sign-in
+        await session.rollback()
+    return success_response(
+        data=AgentSessionResponse(
+            access_token=access_token,
+            expires_at=expires_at,
+            company_id=company_id,
+            company_name=company.name,
+            full_name=membership.full_name,
+            email=membership.email,
+            role=str(getattr(membership, "role", "")),
+        )
+    )
