+"""Demo construction company for the AI assistant: «мёртвые души» and the honest cases around them.
+
+Mustahkam Qurilish: three sites, three weeks of history, the AI assistant
+switched on — for this company only (its own ``ai_agent_enabled`` setting).
+The cases the agents are evaluated on:
+
+- Chilonzor — four workers left ten days ago, but the foreman keeps checking
+  them in and out from his own phone: one device, a minute apart, their
+  registration photo on a phone screen in his cabin, check-outs in one batch.
+  Before they left, each checked in from their own phone with a selfie;
+- Chilonzor — a worker whose phone gives a weak GPS: flags, twice outside the
+  fence, but live selfies and full days. Technology, not fraud;
+- Sergeli — two workers without smartphones, checked in by their honest
+  foreman from his phone: live selfies, on the site, each checks out on their own;
+- Yashnobod — a finishing crew arrives at 09:00 and leaves at 19:00 every day,
+  while the site's schedule says 08:00–18:00. The schedule is wrong, not the people.
+
+Faces are the AI-generated demo faces (docs/investment/demo-faces); the
+check-in photos are drawn from them by scripts/demo_photos.py.
+
+Usage (inside the backend container or a configured backend venv):
+    cd backend
+    python scripts/seed_construction_demo.py --password '...' [--reset]
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import hashlib
+import random
+from dataclasses import dataclass
+from datetime import UTC, datetime, time, timedelta
+from pathlib import Path
+from typing import Literal
+
+import seed_demo_company as base  # noqa: E402 — puts the backend on sys.path
+from demo_photos import live_photo, screen_photo  # noqa: E402
+
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine  # noqa: E402
+
+from app.core.config import get_settings  # noqa: E402
+from app.core.security import hash_password  # noqa: E402
+from app.models import (  # noqa: E402
+    AdminAccount,
+    BrowserDeviceBinding,
+    Company,
+    CompanyObject,
+    CompanySetting,
+    CompanyUser,
+    EmployeeObjectAssignment,
+    Person,
+)
+from app.services.permissions import ROLE_OWNER  # noqa: E402
+from app.services.work_schedule_resolver import WorkScheduleResolver  # noqa: E402
+from app.utils.images import save_image_bytes  # noqa: E402
+
+COMPANY_NAME = "Mustahkam Qurilish"
+FACES_DIR = base.BACKEND_DIR.parent / "docs" / "investment" / "demo-faces"
+
+SITES = {
+    "chilonzor": {
+        "name": "ЖК «Чиланзар Сити», блок 3",
+        "address": "г. Ташкент, Чиланзарский район, ул. Арнасой, 7",
+        "latitude": 41.28032,
+        "longitude": 69.19115,
+        "radius_meters": 150.0,
+    },
+    "sergeli": {
+        "name": "Склад-ангар, Сергели",
+        "address": "г. Ташкент, Сергелийский район, ул. Янги Сергели, 42",
+        "latitude": 41.22681,
+        "longitude": 69.21904,
+        "radius_meters": 120.0,
+    },
+    "yashnobod": {
+        "name": "ЖК «Яшнабад», отделка",
+        "address": "г. Ташкент, Яшнабадский район, ул. Махтумкули, 95",
+        "latitude": 41.30692,
+        "longitude": 69.33641,
+        "radius_meters": 100.0,
+    },
+}
+# Every site is configured for 08:00–18:00, six days a week. For Yashnobod that
+# is the mistake the agents should find.
+SITE_SCHEDULE = {"shift_start": "08:00", "shift_end": "18:00", "working_days": "1,2,3,4,5,6"}
+
+Kind = Literal["foreman", "worker", "left", "weak_gps", "foreman_honest", "no_phone", "late_crew"]
+
+
+@dataclass(frozen=True)
+class Worker:
+    name: str
+    face: str
+    site: str
+    kind: Kind
+
+
+ROSTER = (
+    Worker("Рустам Юлдашев", "face_11.jpg", "chilonzor", "foreman"),
+    Worker("Азамат Норматов", "face_00.jpg", "chilonzor", "worker"),
+    Worker("Бобур Каримов", "face_03.jpg", "chilonzor", "worker"),
+    Worker("Илхом Тураев", "face_16.jpg", "chilonzor", "worker"),
+    Worker("Нодира Сафарова", "face_04.jpg", "chilonzor", "worker"),
+    Worker("Шерзод Алимов", "face_15.jpg", "chilonzor", "weak_gps"),
+    Worker("Тимур Хасанов", "face_17.jpg", "chilonzor", "left"),
+    Worker("Гулчехра Ибрагимова", "face_06.jpg", "chilonzor", "left"),
+    Worker("Мохира Юнусова", "face_05.jpg", "chilonzor", "left"),
+    Worker("Феруза Каримова", "face_07.jpg", "chilonzor", "left"),
+    Worker("Дилшод Мирзаев", "face_12.jpg", "sergeli", "foreman_honest"),
+    Worker("Хуршид Рахмонов", "face_09.jpg", "sergeli", "no_phone"),
+    Worker("Анвар Бакиров", "face_13.jpg", "sergeli", "no_phone"),
+    Worker("Зухра Набиева", "face_01.jpg", "yashnobod", "late_crew"),
+    Worker("Камола Ташпулатова", "face_10.jpg", "yashnobod", "late_crew"),
+    Worker("Дилфуза Эргашева", "face_14.jpg", "yashnobod", "late_crew"),
+)
+WEAK_GPS_OUTSIDE_DAYS_AGO = (3, 8)
+ABSENCE_CHANCE = 0.04
+LATE_CHANCE = 0.1
+
+
+@dataclass
+class Staff:
+    worker: Worker
+    person: Person
+    obj: CompanyObject
+    assignment: EmployeeObjectAssignment
+    face: Path
+
+
+class Phones:
+    """Phones and their bindings: the same phone used by several people is one hash."""
+
+    def __init__(self, company_id, expires_at: datetime) -> None:
+        self.company_id = company_id
+        self.expires_at = expires_at
+        self.user_agents: dict[str, str] = {}
+        self.bindings: dict[tuple, BrowserDeviceBinding] = {}
+
+    @staticmethod
+    def of(owner: str) -> str:
+        return hashlib.sha256(f"mustahkam-phone|{owner}".encode()).hexdigest()
+
+    def user_agent(self, phone: str) -> str:
+        return self.user_agents.setdefault(phone, random.choice(base.USER_AGENTS))
+
+    def binding(self, session: AsyncSession, staff: Staff, phone: str, first_seen: datetime) -> BrowserDeviceBinding:
+        key = (staff.person.id, phone)
+        if key not in self.bindings:
+            binding = BrowserDeviceBinding(
+                company_id=self.company_id,
+                employee_id=staff.person.id,
+                browser_hash=phone,
+                allowed_object_ids=[str(staff.obj.id)],
+                issued_at=first_seen,
+                last_seen_at=first_seen,
+                expires_at=self.expires_at,
+                is_active=True,
+            )
+            session.add(binding)
+            self.bindings[key] = binding
+        return self.bindings[key]
+
+
+class Recorder:
+    """Adds check-in and check-out events with their photo, device and GPS."""
+
+    def __init__(self, session: AsyncSession, company: Company, phones: Phones, media_dir: Path, now_utc: datetime) -> None:
+        self.session = session
+        self.company = company
+        self.phones = phones
+        self.media_dir = media_dir
+        self.now_utc = now_utc
+        self.count = 0
+
+    def add(
+        self,
+        staff: Staff,
+        occurrence,
+        event_type: str,
+        at_utc: datetime,
+        *,
+        phone: str,
+        photo: bytes,
+        similarity: float,
+        check_in_at: datetime | None = None,
+        accuracy: float | None = None,
+        lat: float | None = None,
+        lon: float | None = None,
+        inside: bool = True,
+        risk_flags: list[str] | None = None,
+    ) -> bool:
+        if at_utc > self.now_utc:
+            return False
+        event = base._event(
+            company_id=self.company.id,
+            person=staff.person,
+            obj=staff.obj,
+            assignment=staff.assignment,
+            event_type=event_type,
+            at_utc=at_utc,
+            photo_url=save_image_bytes(photo, self.media_dir),
+            inside=inside,
+            lat=lat,
+            lon=lon,
+            risk_flags=risk_flags,
+            admin_notified_at=at_utc,  # synthetic history: never notify
+            check_in_at=check_in_at,
+            occurrence=occurrence,
+        )
+        event.similarity = round(similarity, 4)
+        event.user_agent = self.phones.user_agent(phone)
+        event.device_binding = self.phones.binding(self.session, staff, phone, at_utc)
+        if accuracy is not None:
+            event.accuracy_meters = round(accuracy, 1)
+        self.session.add(event)
+        self.count += 1
+        return True
+
+
+def _minutes(value: float) -> timedelta:
+    return timedelta(minutes=value)
+
+
+def _live(staff: Staff) -> bytes:
+    return live_photo(staff.face, random.Random(random.random()))
+
+
+def _on_own_phone(rec: Recorder, staff: Staff, occurrence, *, arrive: float, leave: float, **extra) -> None:
+    """A worker with a smartphone: their own phone, a selfie, check-out on their own."""
+    phone = Phones.of(staff.worker.name)
+    check_in_at = occurrence.planned_start_at + _minutes(arrive)
+    if not rec.add(staff, occurrence, "check_in", check_in_at, phone=phone, photo=_live(staff),
+                   similarity=random.uniform(0.72, 0.9), **extra):
+        return
+    rec.add(staff, occurrence, "check_out", occurrence.planned_end_at + _minutes(leave), phone=phone,
+            photo=_live(staff), similarity=random.uniform(0.72, 0.9), check_in_at=check_in_at, **extra)
+
+
+def _regular_times() -> tuple[float, float]:
+    late = random.random() < LATE_CHANCE
+    return (random.uniform(12, 30) if late else random.uniform(-12, 6)), random.uniform(-15, -2)
+
+
+def _dead_souls(rec: Recorder, foreman: Staff, souls: list[tuple[Staff, object]], foreman_in: datetime) -> None:
+    """The foreman checks in, then out, people who no longer come, from his cabin."""
+    phone = Phones.of(foreman.worker.name)
+    cabin_lat = foreman.obj.latitude + 0.00022
+    cabin_lon = foreman.obj.longitude - 0.00031
+    at = foreman_in + _minutes(random.uniform(2, 4))
+    check_ins = {}
+    for staff, occurrence in souls:
+        lat, lon = base._jitter_location(cabin_lat, cabin_lon, 2)
+        if rec.add(staff, occurrence, "check_in", at, phone=phone, photo=screen_photo(staff.face, random.Random(random.random())),
+                   similarity=random.uniform(0.55, 0.63), accuracy=random.uniform(6, 10), lat=lat, lon=lon):
+            check_ins[staff.person.id] = at
+        at += timedelta(seconds=random.uniform(40, 75))
+    if not souls:
+        return
+    at = souls[0][1].planned_end_at - _minutes(random.uniform(4, 6))
+    for staff, occurrence in souls:
+        if staff.person.id in check_ins:
+            lat, lon = base._jitter_location(cabin_lat, cabin_lon, 2)
+            rec.add(staff, occurrence, "check_out", at, phone=phone, photo=screen_photo(staff.face, random.Random(random.random())),
+                    similarity=random.uniform(0.55, 0.63), accuracy=random.uniform(6, 10), lat=lat, lon=lon,
+                    check_in_at=check_ins[staff.person.id])
+        at += timedelta(seconds=random.uniform(30, 60))
+
+
+def _without_smartphones(rec: Recorder, foreman: Staff, crew: list[tuple[Staff, object]], foreman_in: datetime) -> None:
+    """The honest foreman checks in his crew one by one: each on the site, each a selfie."""
+    phone = Phones.of(foreman.worker.name)
+    at = foreman_in + _minutes(random.uniform(2, 5))
+    for staff, occurrence in crew:
+        check_in_at = at
+        if rec.add(staff, occurrence, "check_in", check_in_at, phone=phone, photo=_live(staff),
+                   similarity=random.uniform(0.74, 0.88)):
+            rec.add(staff, occurrence, "check_out", occurrence.planned_end_at - _minutes(random.uniform(2, 18)),
+                    phone=phone, photo=_live(staff), similarity=random.uniform(0.74, 0.88), check_in_at=check_in_at)
+        at += timedelta(seconds=random.uniform(70, 200))
+
+
+def _weak_gps(rec: Recorder, staff: Staff, occurrence, day_offset: int) -> None:
+    arrive, leave = _regular_times()
+    if day_offset in WEAK_GPS_OUTSIDE_DAYS_AGO:
+        # The position jumps ~250 m off the site; the selfie and the hours are normal.
+        _on_own_phone(rec, staff, occurrence, arrive=arrive, leave=leave, accuracy=random.uniform(160, 240),
+                      lat=staff.obj.latitude + 0.0021, lon=staff.obj.longitude + 0.0012, inside=False,
+                      risk_flags=["accuracy_too_low", "gps_accuracy_warning"])
+        return
+    _on_own_phone(rec, staff, occurrence, arrive=arrive, leave=leave, accuracy=random.uniform(90, 150),
+                  risk_flags=["gps_accuracy_warning"])
+
+
+def _day(rec: Recorder, staff_list: list[Staff], resolver: WorkScheduleResolver, day, day_offset: int, left_days_ago: int) -> None:
+    on_shift = [(staff, occ) for staff in staff_list if (occ := resolver.occurrence(staff.assignment, day)) is not None]
+    by_kind: dict[str, list[tuple[Staff, object]]] = {}
+    for staff, occurrence in on_shift:
+        by_kind.setdefault(staff.worker.kind, []).append((staff, occurrence))
+    gone = day_offset <= left_days_ago
+
+    for kind, helped in (("foreman", "left"), ("foreman_honest", "no_phone")):
+        for foreman, occurrence in by_kind.get(kind, []):
+            arrive = -random.uniform(10, 18)
+            _on_own_phone(rec, foreman, occurrence, arrive=arrive, leave=random.uniform(1, 3))
+            foreman_in = occurrence.planned_start_at + _minutes(arrive)
+            crew = by_kind.get(helped, [])
+            if helped == "left" and gone:
+                _dead_souls(rec, foreman, crew, foreman_in)
+            elif helped == "no_phone":
+                _without_smartphones(rec, foreman, [item for item in crew if random.random() > ABSENCE_CHANCE], foreman_in)
+
+    for staff, occurrence in by_kind.get("worker", []) + ([] if gone else by_kind.get("left", [])):
+        if random.random() < ABSENCE_CHANCE:
+            continue
+        arrive, leave = _regular_times()
+        _on_own_phone(rec, staff, occurrence, arrive=arrive, leave=leave)
+    for staff, occurrence in by_kind.get("weak_gps", []):
+        _weak_gps(rec, staff, occurrence, day_offset)
+    for staff, occurrence in by_kind.get("late_crew", []):
+        # They work 09:00–19:00; the site says 08:00–18:00.
+        _on_own_phone(rec, staff, occurrence, arrive=60 + random.uniform(-6, 8), leave=60 + random.uniform(-4, 10))
+
+
+async def seed(session: AsyncSession, args: argparse.Namespace, settings) -> None:
+    await base.remove_previous_demo(session, email=args.email, reset=args.reset)
+    faces = Path(args.photos_dir)
+    missing = sorted(worker.face for worker in ROSTER if not (faces / worker.face).is_file())
+    if missing:
+        raise SystemExit(f"Missing photos in {faces}: {', '.join(missing)}")
+
+    now_utc = datetime.now(UTC)
+    today_local = now_utc.astimezone(base.TASHKENT).date()
+    origin_day = today_local - timedelta(days=args.days + 1)
+    origin_at = datetime.combine(origin_day, time(8, 0), tzinfo=base.TASHKENT).astimezone(UTC)
+
+    company = Company(
+        name=COMPANY_NAME,
+        contact_phone="+998 90 765 43 21",
+        default_language="ru",
+        is_demo=False,
+        subscription_plan="business",  # «Управление»: recording a check-in review is on it
+        subscription_status="active",
+        billing_period="monthly",
+        paid_until=datetime(2027, 1, 15, tzinfo=UTC),
+        seats=50,
+        created_at=origin_at,
+    )
+    session.add(company)
+    await session.flush()
+    admin = AdminAccount(
+        full_name="Демо Стройка",
+        email=args.email,
+        password_hash=hash_password(args.password),
+        preferred_language="ru",
+        is_active=True,
+        email_verified_at=origin_at,
+        created_at=origin_at,
+    )
+    session.add(admin)
+    await session.flush()
+    session.add(CompanyUser(company_id=company.id, account_id=admin.id, role=ROLE_OWNER, is_active=True, created_at=origin_at))
+    session.add(CompanySetting(company_id=company.id, late_grace_minutes=base.LATE_GRACE_MINUTES, ai_agent_enabled=True))
+
+    objects = {}
+    for key, spec in SITES.items():
+        obj = CompanyObject(company_id=company.id, is_active=True, late_grace_minutes=base.LATE_GRACE_MINUTES,
+                            created_at=origin_at, **spec, **SITE_SCHEDULE)
+        session.add(obj)
+        objects[key] = obj
+    await session.flush()
+
+    persons_dir = settings.media_path / "persons"
+    staff_list = []
+    for index, worker in enumerate(ROSTER):
+        person = Person(
+            company_id=company.id,
+            full_name=worker.name,
+            employee_id=f"MQ-{index + 1:03d}",
+            preview_image=save_image_bytes((faces / worker.face).read_bytes(), persons_dir),
+            is_active=True,
+            created_at=origin_at,
+        )
+        session.add(person)
+        await session.flush()
+        obj = objects[worker.site]
+        assignment = EmployeeObjectAssignment(company_id=company.id, employee_id=person.id, object_id=obj.id,
+                                              is_active=True, schedule_mode="object_default", created_at=origin_at)
+        assignment.object = obj
+        session.add(assignment)
+        staff_list.append(Staff(worker, person, obj, assignment, faces / worker.face))
+    await session.flush()
+
+    resolver = WorkScheduleResolver(
+        company_late_grace_minutes=base.LATE_GRACE_MINUTES,
+        not_before={staff.assignment.id: origin_day for staff in staff_list},
+    )
+    phones = Phones(company.id, now_utc + timedelta(days=90))
+    recorder = Recorder(session, company, phones, settings.media_path / "attendance", now_utc)
+    for day_offset in range(args.days, -1, -1):
+        _day(recorder, staff_list, resolver, today_local - timedelta(days=day_offset), day_offset, args.left_days_ago)
+    await session.flush()
+
+    summaries = await base.backfill_daily_summaries(
+        session,
+        company=company,
+        objects=list(objects.values()),
+        assignments=[(staff.obj, staff.assignment) for staff in staff_list],
+        resolver=resolver,
+        days=args.days,
+        today_local=today_local,
+        now_utc=now_utc,
+    )
+    await session.commit()
+    print(
+        f"Created '{COMPANY_NAME}': {len(staff_list)} employees on {len(objects)} sites, "
+        f"{recorder.count} attendance events, {summaries} daily summaries over {args.days} days; "
+        f"AI assistant on. Four workers left {args.left_days_ago} days ago."
+    )
+    print(f"Admin login: {args.email}")
+
+
+async def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--email", default="stroyka@nazarhr.uz")
+    parser.add_argument("--password", required=True)
+    parser.add_argument("--photos-dir", default=str(FACES_DIR), help="directory with the demo face photos")
+    parser.add_argument("--days", type=int, default=21, help="days of history to generate")
+    parser.add_argument("--left-days-ago", type=int, default=10, help="when the four workers stopped coming")
+    parser.add_argument("--reset", action="store_true", help="drop the existing demo company first")
+    parser.add_argument("--seed", type=int, default=20261028, help="RNG seed for reproducibility")
+    args = parser.parse_args()
+    random.seed(args.seed)
+
+    settings = get_settings()
+    engine = create_async_engine(settings.database_url)
+    try:
+        async with async_sessionmaker(engine, expire_on_commit=False)() as session:
+            await seed(session, args, settings)
+    finally:
+        await engine.dispose()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(asyncio.run(main()))
