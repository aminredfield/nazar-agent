+def test_the_assistants_bot_signs_in_with_the_key_not_a_captcha():
+    company_id, account_id, _ = asyncio.run(_seed(enabled=True))
+    client = _client()
+    login = {"email": _EMAILS[account_id], "password": PASSWORD}
+
+    without_key = client.post("/api/ai-agent/service-session", json=login)
+    wrong_password = client.post("/api/ai-agent/service-session", json={**login, "password": "nope"}, headers={"X-Agent-Key": AGENT_KEY})
+    signed_in = client.post("/api/ai-agent/service-session", json=login, headers={"X-Agent-Key": AGENT_KEY})
+
+    assert without_key.status_code == 401 and wrong_password.status_code == 401
+    assert signed_in.status_code == 200, signed_in.text
+    data = signed_in.json()["data"]
+    assert data["company_id"] == str(company_id) and data["role"] == ROLE_OWNER
+    assert client.get("/api/objects", headers={"Authorization": f"Bearer {data['access_token']}"}).status_code == 200
+
+
+def test_the_bot_gets_no_session_where_the_assistant_is_off():
