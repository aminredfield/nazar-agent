+
+
+@router.post(
+    "/service-session",
+    response_model=ApiResponse[AgentSessionResponse],
+    summary="The assistant's own account (its Telegram bot) signs in with the assistant key",
+    include_in_schema=False,
+)
+async def create_service_session(
+    payload: AgentServiceSessionRequest,
+    request: Request,
+    agent_key: str = Header(default="", alias="X-Agent-Key"),
+    session: AsyncSession = Depends(get_db_session),
+):
+    """Вход учётной записи помощника — его Telegram-бота — без Turnstile.
+
+    Обычный вход защищён Turnstile, а бот — сервер, ему капчу не пройти.
+    Вместо неё — ключ помощника: без него этот вход не принимает ни одного
+    пароля, так что подбирать их здесь нельзя. Сессия выдаётся только в
+    компании, где помощник включён, и только с правами этой учётной записи.
+    """
+    if not settings.ai_agent_key or not hmac.compare_digest(agent_key.encode(), settings.ai_agent_key.encode()):
+        raise HTTPException(status.HTTP_401_UNAUTHORIZED, "Assistant key is invalid.")
+    users = CompanyUserRepository(session)
+    account = await users.get_account_by_email(payload.email.strip().lower())
+    if (
+        account is None
+        or not account.is_active
+        or not account.password_hash
+        or not verify_password(payload.password, account.password_hash)
+    ):
+        raise HTTPException(status.HTTP_401_UNAUTHORIZED, "Invalid email or password.")
+    membership = None
+    for candidate in await users.list_active_memberships_for_account(account.id):
+        if await _enabled(session, candidate.company_id):
+            membership = candidate
+            break
+    if membership is None:
+        raise HTTPException(status.HTTP_403_FORBIDDEN, "AI_AGENT_DISABLED: Помощник не включён для компании.")
+    company = await CompanyRepository(session).get(membership.company_id)
+    if company is None:
+        raise HTTPException(status.HTTP_401_UNAUTHORIZED, "User is inactive.")
+
+    access_token, expires_at = create_access_token(user_id=account.id, settings=settings, company_id=company.id)
+    try:
+        await AuditLogRepository(session).create(
+            company_id=company.id,
+            actor_user_id=membership.id,
+            actor_type="company_user",
+            actor_email=membership.email,
+            action="ai_agent.service_session",
+            request_ip=request.client.host if request.client else None,
+        )
+        await session.commit()
+    except Exception:  # pragma: no cover - audit must never break the sign-in
+        await session.rollback()
+    return success_response(
+        data=AgentSessionResponse(
+            access_token=access_token,
+            expires_at=expires_at,
+            company_id=company.id,
+            company_name=company.name,
+            full_name=membership.full_name,
+            email=membership.email,
+            role=str(getattr(membership, "role", "")),
+        )
+    )
