# Meta Model API (https://dev.meta.ai). The key is a secret — never commit it.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# muse-spark-1.3-contributor is ~12-20x cheaper, but Meta trains on its inputs
# and outputs. Use it only with the synthetic demo company, never with real
# clients' data or photos of real people.
ANALYST_MODEL=muse-spark-1.3

# The skeptic runs on a different model than the analysts. Target: Muse Spark
# Open on Baseten — SKEPTIC_API=chat_completions, SKEPTIC_BASE_URL, its own
# SKEPTIC_API_KEY. Empty base URL and key fall back to the Meta settings above.
SKEPTIC_MODEL=muse-spark-1.2
SKEPTIC_API=responses
SKEPTIC_BASE_URL=
SKEPTIC_API_KEY=

# NAZAR API of the company the agent works for. Use a dedicated demo company
# and a separate admin user for the agent — never a real client's account.
NAZAR_BASE_URL=http://localhost:8000/api
NAZAR_EMAIL=
NAZAR_PASSWORD=

# Voice messages: Muse Spark 1.2 takes audio input (Muse Voice Transcribe has
# no Russian or Uzbek).
VOICE_MODEL=muse-spark-1.2

# The agent's own Telegram bot (create it with @BotFather). Only the listed
# chat ids may use it; a stranger who writes to the bot gets their chat id back.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=
# Only if api.telegram.org is blocked on this network: http://host:port or socks5://host:port
TELEGRAM_PROXY=
# Morning brief to every allowed chat at this local (Tashkent) time; empty = off.
BRIEF_TIME=08:30

# Proposals and the audit trail.
AGENT_DB_PATH=nazar_agent.sqlite3
